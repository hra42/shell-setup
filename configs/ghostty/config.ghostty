theme = Catppuccin Mocha
font-family         = MonaspaceNeon Nerd Font
font-family-bold    = MonaspaceXenon Nerd Font
font-family-italic  = MonaspaceRadon Nerd Font
font-family-bold-italic = MonaspaceKrypton Nerd Font

background-opacity = 0.50
background-blur-radius = 20
window-padding-x = 16
window-padding-y = 16
window-padding-balance = true

shell-integration = detect
shell-integration-features = cursor,sudo,title

font-feature = calt   # Texture Healing für Monaspace
font-feature = lira

clipboard-paste-protection = false
confirm-close-surface = false